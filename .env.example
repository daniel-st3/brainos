# Local persistence (legacy mode name); use Supabase for authenticated hosting.
CONTENT_OS_MODE=demo
# Select fictional demo or real feeds. Defaults to demo locally, live with Supabase.
# CONTENT_OS_DATA_MODE=live
# Optional local directory (default .data/newsroom or .data/live-newsroom)
# CONTENT_OS_DATA_DIR=.data/newsroom
# Required only for connected Supabase mode:
# CONTENT_OS_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# CONTENT_OS_EDITOR_ID=the-single-authorized-supabase-user-uuid
# Trigger tasks are optional; they are not needed to run the app.
# TRIGGER_PROJECT_REF=
# TRIGGER_SECRET_KEY=
# Optional explicit trusted origin behind a reverse proxy, e.g. https://newsroom.example.com
# CONTENT_OS_ORIGIN=

# Optional Google runtime OAuth (connector access is NOT runtime access).
# Use a dedicated OAuth app with drive.file; add gmail.readonly only if enabling intake.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_ID=
# GMAIL_INTAKE_ENABLED=false
# Gmail intake remains off during the discovery pilot. No email sends are automated.
# Optional AI enhancement is deliberately not enabled: deterministic research/drafts cost $0.
# Select ONE scheduler. Trigger remains preferred when an account is configured.
# GitHub alternative: repository variable NEWSROOM_SCHEDULER=github and Supabase
# URL variable + SUPABASE_SECRET_KEY Actions secret. Schedules require default branch.
