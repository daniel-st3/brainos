# Copy to .env.worker.local (gitignored); never commit credentials.
BRAINOS_URL=https://your-protected-preview.vercel.app
PRODUCTION_WORKER_TOKEN=
VERCEL_AUTOMATION_BYPASS_SECRET=
MEDIA_INPUT_ROOT=/absolute/path/to/your/recordings
# Optional, default ~/\.brainos-media
# MEDIA_WORK_DIR=
WHISPER_MODEL=small
# Optional full ffmpeg with libass for burned-in subtitles.
# FFMPEG_PATH=
